# ============================================================
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会进入仓库。
# 密钥仅存在于后端进程，前端页面与静态资源中不出现任何密钥。
# ============================================================

# ---------- 模型接入（OpenAI 兼容接口）----------
# 可选示例：
#   DeepSeek : https://api.deepseek.com/v1       模型 deepseek-chat
#   通义千问 : https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
#   OpenAI   : https://api.openai.com/v1         模型 gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx-replace-me
LLM_MODEL=deepseek-chat

# 单次模型调用超时（秒），可配置
LLM_TIMEOUT_S=20
# 仅对超时 / 429 / 5xx 重试，4xx 不重试
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

# ---------- 上下文与检索 ----------
HISTORY_MAX_TURNS=6
HISTORY_MAX_CHARS=4000
RETRIEVAL_TOP_K=4
# 低于该分数判定为知识未命中（kb_miss），不编造答案
RETRIEVAL_MIN_SCORE=3.0
# 当前游戏版本，用于知识的版本适用性折扣
GAME_VERSION=S47

# ---------- 接口 ----------
MAX_MESSAGE_CHARS=1000
APP_PORT=8000

# ---------- 开关 ----------
# 1 = Mock 模式：不调用真实模型，返回固定回复，接口与页面均标记 mock=true
MOCK_LLM=0
