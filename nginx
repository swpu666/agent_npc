server
{
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    listen 443 quic;
    listen [::]:443 ssl;
    listen [::]:443 quic;
    http2 on;
    server_name money8.asia;
    index index.html index.htm default.htm default.html;
    root /root/swpu/swpu_score;
    include /www/server/panel/vhost/nginx/extension/swpu_score/*.conf;
    #CERT-APPLY-CHECK--START
    # 用于SSL证书申请时的文件验证相关配置 -- 请勿删除
    include /www/server/panel/vhost/nginx/well-known/swpu_score.conf;
    #CERT-APPLY-CHECK--END

    #SSL-START SSL相关配置
    #error_page 404/404.html;
    ssl_certificate    /www/server/panel/vhost/cert/swpu_score/fullchain.pem;
    ssl_certificate_key    /www/server/panel/vhost/cert/swpu_score/privkey.pem;
    ssl_protocols TLSv1.1 TLSv1.2 TLSv1.3;
    ssl_ciphers EECDH+CHACHA20:EECDH+CHACHA20-draft:EECDH+AES128:RSA+AES128:EECDH+AES256:RSA+AES256:EECDH+3DES:RSA+3DES:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=31536000";
    add_header Alt-Svc 'quic=":443"; h3=":443"; h3-29=":443"; h3-27=":443";h3-25=":443"; h3-T050=":443"; h3-Q050=":443";h3-Q049=":443";h3-Q048=":443"; h3-Q046=":443"; h3-Q043=":443"';
    error_page 497  https://$host$request_uri;
    #SSL-END

    #ERROR-PAGE-START  错误页相关配置
    #error_page 404 /404.html;
    #error_page 502 /502.html;
    #ERROR-PAGE-END


    #REWRITE-START 伪静态相关配置
    include /www/server/panel/vhost/rewrite/python_swpu_score.conf;
    #REWRITE-END

    #禁止访问的文件或目录
    location ~ ^/(\.user.ini|\.htaccess|\.git|\.svn|\.project|LICENSE|README.md|package.json|package-lock.json|\.env) {
        return 404;
    }

    #一键申请SSL证书验证目录相关设置
    location /.well-known/ {
        root /www/wwwroot/java_node_ssl;
    }

    #禁止在证书验证目录放入敏感文件
    if ( $uri ~ "^/\.well-known/.*\.(php|jsp|py|js|css|lua|ts|go|zip|tar\.gz|rar|7z|sql|bak)$" ) {
        return 403;
    }

    # HTTP反向代理相关配置开始 >>>
    location ~ /purge(/.*) {
        proxy_cache_purge cache_one 127.0.0.1$request_uri$is_args$args;
    }
    
    
# 不带尾斜杠的入口，补斜杠后进入应用
location = /simulator {
    return 302 /simulator/;
}

# 工程文件不对外暴露（本段用普通前缀匹配，这些正则 location 才会优先生效，请勿改成 ^~）
location = /simulator/README.md { return 404; }
location = /simulator/build.mjs  { return 404; }
location = /simulator/serve.mjs  { return 404; }
location ~* ^/simulator/(deploy|\.git)/ { return 404; }

# 站点本体：nginx 直接读仓库目录，无需任何常驻进程，随 nginx 一起开机自启。
# 深链（如 /simulator/volunteer-simulator/profile/basic）命中目录后由 index 自动 301 补尾斜杠。
location /simulator/ {
    alias /root/baoyan/baoyan-test/baoyan/radar-volunteer-simulator/;
    index index.html;
    autoindex off;
}

    # ========== 定制映射：/1/ -> /baoyantest/intraduce/index.html ==========
    # 精确匹配 /1/，使用反向代理获取内容，地址栏保持 /1/ 不变
    # 首页：精确匹配 /1/，返回 index.html（不依赖后端目录索引）
    location = /1/ {
        proxy_pass http://127.0.0.1:10080/intraduce/index.html;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header REMOTE-HOST $remote_addr;
        proxy_set_header X-Scheme $scheme;

        proxy_connect_timeout 30s;
        proxy_read_timeout 86400s;
        proxy_send_timeout 30s;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # 资源：/1/ 下所有子路径（图片、css、js 等）代理到后端 intraduce 目录
    # proxy_pass 结尾带 /intraduce/（斜杠），nginx 会去掉 /1/ 前缀
    # 例：/1/fill-info.png  →  127.0.0.1:10080/intraduce/fill-info.png
    #      /1/reviews/review-3.jpg  →  127.0.0.1:10080/intraduce/reviews/review-3.jpg
    location ^~ /1/ {
        proxy_pass http://127.0.0.1:10080/intraduce/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header REMOTE-HOST $remote_addr;
        proxy_set_header X-Scheme $scheme;

        proxy_connect_timeout 30s;
        proxy_read_timeout 86400s;
        proxy_send_timeout 30s;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # 兼容不带斜杠的 /1，重定向到 /1/
    location = /1 {
        return 302 /1/;
    }
    # ========== 定制映射结束 ==========
    
    # 子路由映射 - baoyan
    location /baoyan/ {
        proxy_pass http://127.0.0.1:3000/;  # 注意末尾的斜杠！
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header REMOTE-HOST $remote_addr;
        proxy_set_header X-Scheme $scheme;
        
        proxy_connect_timeout 30s;
        proxy_read_timeout 86400s;
        proxy_send_timeout 30s;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
    
    # 子路由映射 - baoyan-test
    location /baoyantest/ {
        proxy_pass http://127.0.0.1:10080/;  # 注意末尾的斜杠！
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header REMOTE-HOST $remote_addr;
        proxy_set_header X-Scheme $scheme;
        
        proxy_connect_timeout 30s;
        proxy_read_timeout 86400s;
        proxy_send_timeout 30s;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
    
    location /chajian/downloads/ {
        alias /root/baoyan/chajian/;
        autoindex on;                    # 可选：显示目录列表
        default_type application/octet-stream;

        # 强制下载（不在线预览）
        # add_header Content-Disposition attachment;
    }
    
    # 子路由映射 - ucas
    location /ucas/ {
        proxy_pass http://127.0.0.1:5003/;  # 注意末尾的斜杠！
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header REMOTE-HOST $remote_addr;
        proxy_set_header X-Scheme $scheme;
        
        proxy_connect_timeout 30s;
        proxy_read_timeout 86400s;
        proxy_send_timeout 30s;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # 子路由映射 - 面经库
    location /mianjingku/ {
        proxy_pass http://127.0.0.1:5001/;  # 注意末尾的斜杠！
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header REMOTE-HOST $remote_addr;
        proxy_set_header X-Scheme $scheme;
        
        proxy_connect_timeout 30s;
        proxy_read_timeout 86400s;
        proxy_send_timeout 30s;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
    
    # proxy
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host 127.0.0.1:$server_port;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header REMOTE-HOST $remote_addr;
        add_header X-Cache $upstream_cache_status;
        proxy_set_header X-Host $host:$server_port;
        proxy_set_header X-Scheme $scheme;
        proxy_connect_timeout 30s;
        proxy_read_timeout 86400s;
        proxy_send_timeout 30s;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # HTTP反向代理相关配置结束 <<<

    access_log  /www/wwwlogs/swpu_score.log;
    error_log  /www/wwwlogs/swpu_score.error.log;
}